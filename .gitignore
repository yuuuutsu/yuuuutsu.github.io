# 依赖工具包（体积大，且能在部署时自动安装）
node_modules/

# 构建产物（部署时会自动生成）
public/
resources/

# Hugo 锁文件
.hugo_build.lock

# 临时/日志文件
*.log
build-log.txt
env-check.txt
title-check.txt
server-check.txt
check.txt
.local-checks/

# 调试残留：散落在根目录、以点开头的截图 / 网页快照 / 记录 / 脚本
/.*.png
/.*.html
/.*.txt
/.*.py
/.*.js
/.*.css

# 旧文件备份
home.html.bak
*.bak

# 系统文件
.DS_Store
Thumbs.db
